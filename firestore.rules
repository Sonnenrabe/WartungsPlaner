rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('activeGroupId' in data) || (data.activeGroupId is string && data.activeGroupId.size() <= 128)) &&
             (!('joinedGroupIds' in data) || (data.joinedGroupIds is list && data.joinedGroupIds.size() <= 50));
    }

    function isValidGroup(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.code is string && data.code.size() >= 4 && data.code.size() <= 20 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 30 &&
             (data.memberUids.size() == 0 || data.memberUids[0] is string) &&
             (!('deviceGroups' in data) || (data.deviceGroups is list && data.deviceGroups.size() <= 50));
    }

    function isValidGroupCode(data) {
      return data.code is string && data.code.size() >= 4 && data.code.size() <= 20 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidMachine(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.category is string && data.category.size() <= 60 &&
             data.groupTag is string && data.groupTag.size() <= 60 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000)) &&
             (!('nextDueDate' in data) || (data.nextDueDate is string && data.nextDueDate.size() <= 30)) &&
             (!('nextDueMaintenance' in data) || (data.nextDueMaintenance is string && data.nextDueMaintenance.size() <= 200)) &&
             (!('lastMaintenanceDate' in data) || (data.lastMaintenanceDate is string && data.lastMaintenanceDate.size() <= 30)) &&
             (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 50)) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 30 &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidMaintenance(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.machineId is string && data.machineId.size() <= 128 &&
             data.machineName is string && data.machineName.size() <= 120 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.type is string && data.type.size() <= 60 &&
             data.completedDate is string && data.completedDate.size() <= 30 &&
             (!('nextScheduledDate' in data) || (data.nextScheduledDate is string && data.nextScheduledDate.size() <= 30)) &&
             (!('performedBy' in data) || (data.performedBy is string && data.performedBy.size() <= 100)) &&
             (!('cost' in data) || (data.cost is number && data.cost >= 0)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000)) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 30 &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid == userId);
      allow list, delete: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'activeGroupId', 'joinedGroupIds', 'updatedAt']);
    }

    // Family Groups
    match /groups/{groupId} {
      allow get: if isSignedIn() && (resource == null || (request.auth.uid in resource.data.memberUids));
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);

      allow create: if isSignedIn() &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidGroup(incoming());

      allow update: if isSignedIn() && isValidGroup(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
        // Action 1: Owner updates group settings (name, code, memberUids, deviceGroups, updatedAt)
        (existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'memberUids', 'deviceGroups', 'updatedAt'])) ||
        // Action 2: Any group member updates custom device groups
        ((request.auth.uid in existing().memberUids) && incoming().ownerId == existing().ownerId && incoming().code == existing().code &&
         incoming().diff(existing()).affectedKeys().hasOnly(['deviceGroups', 'updatedAt'])) ||
        // Action 3: New member joins using sync code
        (incoming().ownerId == existing().ownerId && incoming().code == existing().code &&
         incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
         incoming().memberUids.hasAll(existing().memberUids) &&
         (request.auth.uid in incoming().memberUids) &&
         incoming().memberUids.size() == existing().memberUids.size() + 1)
      );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // Machines subcollection
      match /machines/{machineId} {
        allow get: if isSignedIn() && (resource == null || (request.auth.uid in resource.data.memberUids));
        allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);

        allow create: if isSignedIn() &&
                         (request.auth.uid in incoming().memberUids) &&
                         incoming().createdBy == request.auth.uid &&
                         incoming().groupId == groupId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidMachine(incoming());

        allow update: if isSignedIn() &&
                         (request.auth.uid in existing().memberUids) &&
                         (request.auth.uid in incoming().memberUids) &&
                         incoming().groupId == existing().groupId &&
                         incoming().createdBy == existing().createdBy &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidMachine(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'groupTag', 'location', 'notes', 'nextDueDate', 'nextDueMaintenance', 'lastMaintenanceDate', 'tasks', 'memberUids', 'updatedAt']);

        allow delete: if isSignedIn() && (request.auth.uid in existing().memberUids);
      }

      // Maintenances subcollection
      match /maintenances/{maintenanceId} {
        allow get: if isSignedIn() && (resource == null || (request.auth.uid in resource.data.memberUids));
        allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);

        allow create: if isSignedIn() &&
                         (request.auth.uid in incoming().memberUids) &&
                         incoming().createdBy == request.auth.uid &&
                         incoming().groupId == groupId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidMaintenance(incoming());

        allow update: if isSignedIn() &&
                         (request.auth.uid in existing().memberUids) &&
                         (request.auth.uid in incoming().memberUids) &&
                         incoming().groupId == existing().groupId &&
                         incoming().machineId == existing().machineId &&
                         incoming().createdBy == existing().createdBy &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidMaintenance(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['machineName', 'title', 'type', 'completedDate', 'nextScheduledDate', 'performedBy', 'cost', 'notes', 'memberUids', 'updatedAt']);

        allow delete: if isSignedIn() && (request.auth.uid in existing().memberUids);
      }
    }

    // Public invite codes directory
    match /group_codes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if false; // Disallow scraping entire code database

      allow create: if isSignedIn() &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidGroupCode(incoming());

      allow update, delete: if isSignedIn() &&
                               exists(/databases/$(database)/documents/groups/$(existing().groupId)) &&
                               get(/databases/$(database)/documents/groups/$(existing().groupId)).data.ownerId == request.auth.uid;
    }
  }
}
