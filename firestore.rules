rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('activeGroupId' in data) || (data.activeGroupId is string && data.activeGroupId.size() <= 128)) &&
             (!('joinedGroupIds' in data) || (data.joinedGroupIds is list && data.joinedGroupIds.size() <= 50));
    }

    function isValidGroup(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.code is string && data.code.size() >= 3 && data.code.size() <= 30 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 &&
             (data.memberUids.size() == 0 || data.memberUids[0] is string) &&
             (!('deviceGroups' in data) || (data.deviceGroups is list && data.deviceGroups.size() <= 50));
    }

    function isValidGroupCode(data) {
      return data.code is string && data.code.size() >= 3 && data.code.size() <= 30 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids);
    }

    function isValidMachine(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.category is string && data.category.size() <= 60 &&
             data.groupTag is string && data.groupTag.size() <= 60 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000)) &&
             (!('nextDueDate' in data) || (data.nextDueDate is string && data.nextDueDate.size() <= 30)) &&
             (!('nextDueMaintenance' in data) || (data.nextDueMaintenance is string && data.nextDueMaintenance.size() <= 200)) &&
             (!('lastMaintenanceDate' in data) || (data.lastMaintenanceDate is string && data.lastMaintenanceDate.size() <= 30)) &&
             (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 50)) &&
             (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 50)) &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidMaintenance(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.machineId is string && data.machineId.size() <= 128 &&
             data.machineName is string && data.machineName.size() <= 120 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.type is string && data.type.size() <= 60 &&
             data.completedDate is string && data.completedDate.size() <= 30 &&
             (!('nextScheduledDate' in data) || (data.nextScheduledDate is string && data.nextScheduledDate.size() <= 30)) &&
             (!('performedBy' in data) || (data.performedBy is string && data.performedBy.size() <= 100)) &&
             (!('cost' in data) || (data.cost is number && data.cost >= 0)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000)) &&
             (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 50)) &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    // User Profiles: user can only read/write their own profile
    match /users/{userId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid == userId);
      allow list, delete: if isSignedIn() && request.auth.uid == userId;

      allow create, update: if isSignedIn() &&
                               request.auth.uid == userId &&
                               incoming().userId == request.auth.uid &&
                               isValidUserProfile(incoming());
    }

    // Family Groups
    match /groups/{groupId} {
      // Any signed-in user can get group details (for joining via code)
      allow get: if isSignedIn();
      // Only members can list their groups via whereArrayContains
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);

      allow create: if isSignedIn() &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       isValidGroup(incoming());

      allow update: if isSignedIn() && isValidGroup(incoming()) && (
        // Action 1: Owner updates settings or device groups
        (existing().ownerId == request.auth.uid) ||
        // Action 2: Existing member updates device groups or leaves (cannot change ownerId)
        ((request.auth.uid in existing().memberUids) &&
         incoming().ownerId == existing().ownerId) ||
        // Action 3: New member joins by adding their UID without modifying core metadata
        ((request.auth.uid in incoming().memberUids) &&
         incoming().memberUids.hasAll(existing().memberUids) &&
         incoming().ownerId == existing().ownerId &&
         incoming().code == existing().code &&
         incoming().name == existing().name)
      );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // Machines subcollection
      match /machines/{machineId} {
        allow get, list: if isSignedIn() && (
          isGroupMember(groupId) || (resource != null && (request.auth.uid in resource.data.memberUids))
        );

        allow create: if isSignedIn() &&
                         isGroupMember(groupId) &&
                         incoming().groupId == groupId &&
                         isValidMachine(incoming());

        allow update: if isSignedIn() &&
                         isGroupMember(groupId) &&
                         isValidMachine(incoming());

        allow delete: if isSignedIn() && isGroupMember(groupId);
      }

      // Maintenances subcollection
      match /maintenances/{maintenanceId} {
        allow get, list: if isSignedIn() && (
          isGroupMember(groupId) || (resource != null && (request.auth.uid in resource.data.memberUids))
        );

        allow create: if isSignedIn() &&
                         isGroupMember(groupId) &&
                         incoming().groupId == groupId &&
                         isValidMaintenance(incoming());

        allow update: if isSignedIn() &&
                         isGroupMember(groupId) &&
                         isValidMaintenance(incoming());

        allow delete: if isSignedIn() && isGroupMember(groupId);
      }
    }

    // Public invite codes directory
    match /group_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false; // Disallow scraping entire code database

      allow create: if isSignedIn() && isValidGroupCode(incoming());

      allow update: if isSignedIn() && isValidGroupCode(incoming()) && (
        !exists(/databases/$(database)/documents/groups/$(existing().groupId)) ||
        get(/databases/$(database)/documents/groups/$(existing().groupId)).data.ownerId == request.auth.uid
      );

      allow delete: if isSignedIn() && (
        !exists(/databases/$(database)/documents/groups/$(existing().groupId)) ||
        get(/databases/$(database)/documents/groups/$(existing().groupId)).data.ownerId == request.auth.uid
      );
    }
  }
}
